{
  "name": "raga",
  "private": true,
  "version": "1.0.0",
  "description": "Raga: free 3D anatomy atlas and Latin short-answer quiz",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "python3 pipeline/build_content.py",
    "test": "esbuild src/quiz/grader.ts --bundle --format=esm --platform=node --outfile=.cache/grader.mjs --log-level=error && node tests/grader.test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.2.6",
    "@fontsource-variable/source-serif-4": "5.2.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.176.0",
    "three-mesh-bvh": "0.9.1"
  },
  "devDependencies": {
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.176.0",
    "@vitejs/plugin-react": "4.6.0",
    "typescript": "5.8.3",
    "vite": "6.4.1"
  }
}